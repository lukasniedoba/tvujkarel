# Lokální náhled: bez indexace a bez odesílání e-mailů.
# Zkopírujte do .env. Používejte doslovné hodnoty, bez interpolace ${PROMENNA}.
# PUBLIC_* jsou veřejné údaje. Nikdy sem nevkládejte hesla nebo AWS klíče.
PUBLIC_SITE_MODE=preview
PUBLIC_SITE_URL=https://tvujkarel.cz

# Nevyplněné kontakty zůstávají v náhledu označené; nevymýšlejte náhradní údaje.
PUBLIC_PHONE=
# Normalizované mezinárodní číslo s +, bez mezer a bez prefixu tel:.
PUBLIC_PHONE_TEL=
PUBLIC_CONTACT_EMAIL=
PUBLIC_REGISTERED_OFFICE=
PUBLIC_VAT_ID=
PUBLIC_AVAILABILITY=

# Zapnout pouze po potvrzení zadavatelem. Analytics je v kódu vypnutá.
PUBLIC_ENABLE_APPLE=false
PUBLIC_ENABLE_WHATSAPP=false
# Potvrzený odkaz ve tvaru https://wa.me/mezinarodnicislo (bez +).
PUBLIC_WHATSAPP_URL=

# Skutečný poskytovatel cílové schránky a schválené doby/pravidla uchování.
PUBLIC_MAILBOX_PROVIDER=
PUBLIC_INQUIRY_RETENTION=
PUBLIC_LOG_RETENTION=
PUBLIC_PRIVACY_APPROVED=false
# Potvrzuje veřejné texty ve všech jazycích, pravidla diagnostiky,
# rozsah služeb a oprávnění používat všechny publikované obrázky.
PUBLIC_CONTENT_APPROVED=false

# Samostatná produkční kontrola vyžaduje skutečně provedená ověření.
# Tyto přepínače se nemají přepnout jen kvůli úspěšnému buildu.
CONTACT_DETAILS_VERIFIED=false
# Ověřený SES sender, povolený recipient a skutečně potvrzený příjem zprávy.
CONTACT_DELIVERY_VERIFIED=false

# Výchozí stav nic neposílá; validní formulář vrací PREVIEW_DISABLED.
# Hodnota ses zapíná skutečné posílání a patří až do schválené konfigurace.
CONTACT_MODE=disabled
CONTACT_SENDER=
CONTACT_RECIPIENT=
CONTACT_SES_REGION=eu-central-1
# Čárkou oddělené přesné origins bez cesty a bez koncového lomítka.
# Při disabled a prázdné hodnotě jsou povolené pouze místní origins
# localhost / 127.0.0.1 / [::1] se stejným portem jako požadavek.
CONTACT_ALLOWED_ORIGINS=
CONTACT_MAX_BODY_BYTES=20480
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=600000
CONTACT_RATE_LIMIT_MAX_KEYS=10000
